{
  "expo": {
    "name": "Oor Nithi (ஊர் நிதி)",
    "slug": "oor-nithi-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B3C2D"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B3C2D"
      },
      "package": "com.oornithi.app"
    },
    "plugins": [
      "expo-sharing"
    ]
  }
}
